# Star Knowledge Base 环境变量模板
# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，不会提交。
#
# 零摩擦说明:
#   LLM 配置全部可选。不配 LLM_API_KEY 也能跑，sync_stars 和 mcp_server
#   会自动降级到启发式模式（用 GitHub API 原始数据生成元数据 + 关键词匹配搜索）。
#   配置 LLM 后可获得更高质量的摘要和语义搜索能力。

# ==== GitHub 配置（sync_stars.py 必填）====

# 要拉取 starred 的 GitHub 用户名
GITHUB_USERNAME=your-github-username

# GitHub Token（本地调试用，Actions 中由 GITHUB_TOKEN 自动注入）
# 建议使用 fine-grained token，至少需要 public_repo 读权限
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 是否强制重新生成所有元数据（true 时忽略缓存）
FORCE_REFRESH=false

# ==== LLM 配置（可选，推荐配置以获得更好的元数据和搜索体验）====
#
# 免费 API 渠道推荐（2026 年）:
#
# 1. 智谱 GLM-4-Flash（推荐，国内首选，完全免费）
#    注册地址: https://open.bigmodel.cn/
#    LLM_PROVIDER=openai
#    LLM_API_KEY=你注册后拿到的 key
#    LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#    LLM_MODEL=glm-4-flash
#
# 2. Groq（海外，免费速率限制，速度极快）
#    注册地址: https://console.groq.com/
#    LLM_PROVIDER=openai
#    LLM_API_KEY=你注册后拿到的 key
#    LLM_BASE_URL=https://api.groq.com/openai/v1
#    LLM_MODEL=llama-3.3-70b-versatile
#
# 3. DeepSeek（国内，付费但极便宜，约 0.001 元/千 token）
#    LLM_PROVIDER=openai
#    LLM_BASE_URL=https://api.deepseek.com/v1
#    LLM_MODEL=deepseek-chat
#
# 4. OpenAI 官方（质量稳定，国内需代理）
#    LLM_PROVIDER=openai
#    LLM_BASE_URL=（留空）
#    LLM_MODEL=gpt-4o-mini
#
# 5. Anthropic Claude（质量好，国内需代理）
#    LLM_PROVIDER=anthropic
#    LLM_MODEL=claude-3-5-sonnet-20241022

# LLM 提供商：openai 或 anthropic
# openai 兼容接口可对接 OpenAI / DeepSeek / Qwen / Moonshot / 智谱 GLM / Groq / 自部署 vLLM 等
LLM_PROVIDER=openai

# LLM API 密钥（留空则降级到启发式模式，仍然可用）
LLM_API_KEY=

# LLM API 基础 URL（可选）
# OpenAI 官方:    https://api.openai.com/v1（留空即可）
# 智谱 GLM:      https://open.bigmodel.cn/api/paas/v4
# DeepSeek:      https://api.deepseek.com/v1
# Groq:          https://api.groq.com/openai/v1
# Qwen:          https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=

# LLM 模型名称（可选，有默认值）
# OpenAI 默认:    gpt-4o-mini
# Anthropic 默认: claude-3-5-sonnet-20241022
# 智谱推荐:       glm-4-flash（免费）或 glm-4.7-flash（免费，性能更强）
# DeepSeek 推荐:  deepseek-chat
# Groq 推荐:      llama-3.3-70b-versatile
LLM_MODEL=

# 请求超时秒数（可选，默认 60）
LLM_TIMEOUT=60

# ==== MCP server 配置（mcp_server.py 用）====

# data.json 数据源（二选一）
# 生产环境用 URL（指向 GitHub Pages）
STAR_DATA_URL=https://your-username.github.io/star-knowledge-base/data.json
# 开发调试可用本地路径
# STAR_DATA_LOCAL=./public/data.json

# 数据刷新间隔秒数（可选，默认 3600）
STAR_REFRESH_SECONDS=3600
