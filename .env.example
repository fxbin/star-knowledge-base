# Star Knowledge Base 环境变量模板
# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，不会提交。

# ==== GitHub 配置（sync_stars.py 用）====

# 要拉取 starred 的 GitHub 用户名
GITHUB_USERNAME=your-github-username

# GitHub Token（本地调试用，Actions 中由 GITHUB_TOKEN 自动注入）
# 建议使用 fine-grained token，至少需要 public_repo 读权限
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 是否强制重新生成所有元数据（true 时忽略缓存）
FORCE_REFRESH=false

# ==== LLM 配置（sync_stars.py 和 mcp_server.py 共用）====

# LLM 提供商：openai 或 anthropic
# openai 兼容接口可对接 OpenAI / DeepSeek / Qwen / Moonshot / 智谱 GLM / 自部署 vLLM 等
LLM_PROVIDER=openai

# LLM API 密钥
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# LLM API 基础 URL（可选）
# OpenAI 官方: https://api.openai.com/v1（留空即可）
# DeepSeek:   https://api.deepseek.com/v1
# 智谱 GLM:   https://open.bigmodel.cn/api/paas/v4
# Qwen:       https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=

# LLM 模型名称（可选，有默认值）
# OpenAI 默认:        gpt-4o-mini
# Anthropic 默认:     claude-3-5-sonnet-20241022
# DeepSeek 推荐:      deepseek-chat
# 智谱 GLM 推荐:      glm-4-flash
LLM_MODEL=

# 请求超时秒数（可选，默认 60）
LLM_TIMEOUT=60

# ==== MCP server 配置（mcp_server.py 用）====

# data.json 数据源（二选一）
# 生产环境用 URL（指向 GitHub Pages）
STAR_DATA_URL=https://your-username.github.io/star-knowledge-base/data.json
# 开发调试可用本地路径
# STAR_DATA_LOCAL=./public/data.json

# 数据刷新间隔秒数（可选，默认 3600）
STAR_REFRESH_SECONDS=3600
